[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist]
"1"="mndncghnabjmepgdapcijjohdjonkkle"

[HKEY_LOCAL_MACHINE\SOFTWARE\Google\Chrome\Extensions\mndncghnabjmepgdapcijjohdjonkkle]
"update_url"="https://www.santafe.gob.ar/documentos/rcivil/extension/updates.xml"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Google\Chrome\Extensions\mndncghnabjmepgdapcijjohdjonkkle]
