Windows Registry Editor Version 5.00

; ==============================================================================
; Google Chrome
; ==============================================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"ExtensionSettings"="{\"*\":{\"install_sources\":[\"https://www.santafe.gob.ar/*\"]},\"mndncghnabjmepgdapcijjohdjonkkle\":{\"installation_mode\":\"allowed\",\"update_url\":\"https://www.santafe.gob.ar/documentos/rcivil/extension/updates.xml\"}}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallSources]
