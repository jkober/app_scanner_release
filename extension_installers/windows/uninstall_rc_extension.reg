[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Chromium]
"ExtensionSettings"=-

[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Chromium\ExtensionInstallSources]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Chromium\ExtensionInstallAllowlist]

